include_guard(GLOBAL)

if(EMSCRIPTEN)
    set(HELIX_PLATFORM web)
    foreach(var CMAKE_AR CMAKE_C_COMPILER_AR CMAKE_CXX_COMPILER_AR)
        set(${var} "${HELIX_EMSCRIPTEN_AR}")
    endforeach()
    foreach(var CMAKE_RANLIB CMAKE_C_COMPILER_RANLIB CMAKE_CXX_COMPILER_RANLIB)
        set(${var} "${HELIX_EMSCRIPTEN_RANLIB}")
    endforeach()
    set(CMAKE_CROSSCOMPILING_EMULATOR "${HELIX_EMSCRIPTEN_NODE}")
elseif(ANDROID)
    set(HELIX_PLATFORM android)
elseif(WIN32)
    set(HELIX_PLATFORM windows)
elseif(UNIX AND NOT APPLE)
    set(HELIX_PLATFORM linux)
else()
    message(FATAL_ERROR "Helix: unsupported platform ${CMAKE_SYSTEM_NAME}")
endif()

set(HELIX_ALL_PLATFORMS windows linux android web)
set(HELIX_POSIX_PLATFORMS linux android web)

if(HELIX_PLATFORM IN_LIST HELIX_POSIX_PLATFORMS)
    set(HELIX_PLATFORM_POSIX ON)
else()
    set(HELIX_PLATFORM_POSIX OFF)
endif()

message(STATUS "Helix: platform ${HELIX_PLATFORM}, compiler ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
