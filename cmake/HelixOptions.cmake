include_guard(GLOBAL)

option(HELIX_BUILD_TESTS "Build unit tests" ${PROJECT_IS_TOP_LEVEL})
option(HELIX_BUILD_BENCHMARKS "Build benchmarks" ${PROJECT_IS_TOP_LEVEL})
option(HELIX_WARNINGS_AS_ERRORS "Treat warnings as errors" ON)
option(HELIX_ENABLE_ASAN "Build with AddressSanitizer" OFF)
option(HELIX_ENABLE_SIMD128 "Use wasm simd128 on the web" ON)

set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)

if(MSVC)
    string(REGEX REPLACE "/EH[a-z]+|/GR" "" CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
endif()

if(HELIX_BUILD_TESTS)
    enable_testing()
endif()

function(helix_apply_options target)
    cmake_parse_arguments(ARG "TOOL" "" "" ${ARGN})
    target_compile_features(${target} PUBLIC cxx_std_23)

    string(TOUPPER "${HELIX_PLATFORM}" platform_upper)
    target_compile_definitions(${target} PUBLIC HX_PLATFORM_${platform_upper}=1)

    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /wd4324 /permissive- /utf-8 /Zc:__cplusplus /Zc:preprocessor /Zc:inline /Gy /Gw)
        if(HELIX_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE /WX)
        endif()
        if(ARG_TOOL)
            target_compile_options(${target} PRIVATE /EHsc /GR)
        else()
            target_compile_options(${target} PRIVATE /EHs-c- /GR-)
            target_compile_definitions(${target} PRIVATE _HAS_EXCEPTIONS=0)
        endif()
        target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS NOMINMAX WIN32_LEAN_AND_MEAN)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wnon-virtual-dtor -Wno-missing-field-initializers)
        if(HELIX_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
        if(NOT ARG_TOOL)
            target_compile_options(${target} PRIVATE -fno-exceptions -fno-rtti)
        endif()
        if(HELIX_ENABLE_ASAN)
            target_compile_options(${target} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
            target_link_options(${target} PRIVATE -fsanitize=address)
        endif()
    endif()

    if(HELIX_PLATFORM STREQUAL "web" AND HELIX_ENABLE_SIMD128)
        target_compile_options(${target} PRIVATE -msimd128)
    endif()
endfunction()
