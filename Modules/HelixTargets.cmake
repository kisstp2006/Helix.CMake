include_guard(GLOBAL)

# Library layout: Source/Helix/<Name>/<Topic>/..., platform code in .../Platform/<Win|Linux|Android|Web|Posix>/.
function(helix_collect_sources out_var root)
    file(GLOB_RECURSE all CONFIGURE_DEPENDS "${root}/*.cpp")
    set(result "")
    foreach(file IN LISTS all)
        set(keep ON)
        foreach(folder IN LISTS HELIX_PLATFORM_FOLDERS)
            if(file MATCHES "/Platform/${folder}/" AND NOT folder STREQUAL HELIX_PLATFORM_FOLDER)
                set(keep OFF)
            endif()
        endforeach()
        if(file MATCHES "/Platform/Posix/" AND NOT HELIX_PLATFORM_POSIX)
            set(keep OFF)
        endif()
        if(keep)
            list(APPEND result "${file}")
        endif()
    endforeach()
    set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

function(helix_add_library name)
    cmake_parse_arguments(ARG "TOOL" "ALIAS" "PUBLIC_DEPS;PRIVATE_DEPS" ${ARGN})
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Source/Helix")
    file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/Source/Helix/*.h")
    add_library(${name} STATIC ${sources} ${headers})
    add_library(Helix::${ARG_ALIAS} ALIAS ${name})
    target_include_directories(${name} PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Source>)
    target_link_libraries(${name} PUBLIC ${ARG_PUBLIC_DEPS} PRIVATE ${ARG_PRIVATE_DEPS})
    if(ARG_TOOL)
        helix_apply_options(${name} TOOL)
    else()
        helix_apply_options(${name})
    endif()
endfunction()

# DOTNET: the program runs C# (the .NET runtime is in the process): on the Web the function registered with
# helix_set_dotnet_web_executable links it into the runtime's module (and may set the target's HELIX_RUN_COMMAND, the
# command line tests run it with).
# CHECK: a test, benchmark or fuzz program: on the Web it links at -O1 (its objects keep the build's optimization;
# binaryen over the whole module is for applications), the target property HELIX_WEB_LINK_OPTIMIZATION says so to
# the .NET web link.
function(helix_add_executable name)
    cmake_parse_arguments(ARG "TOOL;DOTNET;CHECK" "" "SOURCES;DEPS" ${ARGN})
    add_executable(${name} ${ARG_SOURCES})
    target_link_libraries(${name} PRIVATE ${ARG_DEPS})
    if(ARG_TOOL)
        helix_apply_options(${name} TOOL)
    else()
        helix_apply_options(${name})
    endif()
    if(HELIX_PLATFORM STREQUAL "web")
        if(ARG_CHECK)
            set_target_properties(${name} PROPERTIES HELIX_WEB_LINK_OPTIMIZATION -O1)
            if(NOT ARG_DOTNET)
                target_link_options(${name} PRIVATE -O1)
            endif()
        endif()
        get_property(dotnet_web GLOBAL PROPERTY HELIX_DOTNET_WEB_EXECUTABLE)
        if(ARG_DOTNET AND dotnet_web)
            cmake_language(CALL ${dotnet_web} ${name})
        else()
            target_link_options(${name} PRIVATE -sALLOW_MEMORY_GROWTH=1 -sEXIT_RUNTIME=1 -sENVIRONMENT=node)
        endif()
    endif()
endfunction()

# The command line a test runs a program with: its HELIX_RUN_COMMAND, or the program.
function(helix_run_command out name)
    get_target_property(command ${name} HELIX_RUN_COMMAND)
    if(NOT command)
        set(command ${name})
    endif()
    set(${out} ${command} PARENT_SCOPE)
endfunction()

# Tests: every .cpp under Tests/ except files matching EXCLUDE; Tests/ is an include root for shared test helpers.
function(helix_add_test_suite name)
    if(NOT HELIX_BUILD_TESTS OR NOT PROJECT_IS_TOP_LEVEL)
        return()
    endif()
    cmake_parse_arguments(ARG "DOTNET" "EXCLUDE" "DEPS;EXTRA_SOURCES" ${ARGN})
    helix_require(Testing)
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Tests")
    if(ARG_EXCLUDE)
        list(FILTER sources EXCLUDE REGEX "${ARG_EXCLUDE}")
    endif()
    set(dotnet "")
    if(ARG_DOTNET)
        set(dotnet DOTNET)
    endif()
    helix_add_executable(${name} ${dotnet} CHECK SOURCES ${sources} ${ARG_EXTRA_SOURCES} DEPS ${ARG_DEPS} Helix::TestMain)
    target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/Source ${CMAKE_CURRENT_SOURCE_DIR}/Tests)
    if(NOT HELIX_PLATFORM STREQUAL "android")
        helix_run_command(command ${name})
        add_test(NAME ${name} COMMAND ${command} --junit=${CMAKE_BINARY_DIR}/test-results/${name}.xml)
    endif()
endfunction()

function(helix_add_benchmark_suite name)
    if(NOT HELIX_BUILD_BENCHMARKS OR NOT PROJECT_IS_TOP_LEVEL)
        return()
    endif()
    cmake_parse_arguments(ARG "" "" "DEPS" ${ARGN})
    helix_require(Testing)
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Benchmarks")
    helix_add_executable(${name} CHECK SOURCES ${sources} DEPS ${ARG_DEPS} Helix::BenchMain)
    target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/Source)
endfunction()

# Fuzz targets: every .cpp under Fuzz/ on Helix::FuzzMain; ctest runs a short, fixed set of rounds (ROUNDS, 40).
function(helix_add_fuzz_suite name)
    if(NOT HELIX_BUILD_TESTS OR NOT PROJECT_IS_TOP_LEVEL)
        return()
    endif()
    cmake_parse_arguments(ARG "" "ROUNDS" "DEPS;EXTRA_SOURCES" ${ARGN})
    if(NOT ARG_ROUNDS)
        set(ARG_ROUNDS 40)
    endif()
    helix_require(Testing)
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Fuzz")
    helix_add_executable(${name} CHECK SOURCES ${sources} ${ARG_EXTRA_SOURCES} DEPS ${ARG_DEPS} Helix::FuzzMain)
    target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/Source ${CMAKE_CURRENT_SOURCE_DIR}/Tests)
    if(HELIX_PLATFORM STREQUAL "linux")
        # Names in the call stack of a crash.
        target_link_options(${name} PRIVATE -rdynamic)
    endif()
    if(NOT HELIX_PLATFORM STREQUAL "android")
        add_test(NAME ${name} COMMAND ${name} --rounds=${ARG_ROUNDS})
    endif()
endfunction()

# A shared library of a static library and every static Helix library it links (their object files), for programs
# that load modules at run time: the program and its modules link it and share its one copy of the libraries' state.
# Every symbol is exported (all symbols on Windows, default visibility elsewhere); code built against it gets
# HX_SHARED_IMPORT, so the global data its headers read (HX_IMPORT_DATA) is imported. Built only when linked. The Web
# has no shared libraries: its modules are linked in.
function(helix_add_shared_runtime name)
    cmake_parse_arguments(ARG "" "ROOT;ALIAS;OUTPUT_NAME" "" ${ARGN})
    set(pending ${ARG_ROOT})
    set(statics "")
    set(others "")
    while(pending)
        list(POP_FRONT pending item)
        if(TARGET ${item})
            get_target_property(aliased ${item} ALIASED_TARGET)
            if(aliased)
                set(item ${aliased})
            endif()
            get_target_property(type ${item} TYPE)
            get_target_property(imported ${item} IMPORTED)
            if(type STREQUAL "STATIC_LIBRARY" AND NOT imported)
                if(NOT item IN_LIST statics)
                    list(APPEND statics ${item})
                    get_target_property(links ${item} LINK_LIBRARIES)
                    if(links)
                        list(APPEND pending ${links})
                    endif()
                endif()
            else()
                list(APPEND others ${item})
            endif()
        elseif(item)
            list(APPEND others ${item})
        endif()
    endwhile()
    list(REMOVE_DUPLICATES others)
    # Imported targets are seen only where their package was found: found again here.
    if("Threads::Threads" IN_LIST others AND NOT TARGET Threads::Threads)
        find_package(Threads REQUIRED)
    endif()
    set(objects "")
    foreach(target IN LISTS statics)
        list(APPEND objects "$<TARGET_OBJECTS:${target}>")
    endforeach()
    add_library(${name} SHARED EXCLUDE_FROM_ALL ${objects})
    add_library(Helix::${ARG_ALIAS} ALIAS ${name})
    # Next to the programs of the build, which find it there.
    set_target_properties(${name} PROPERTIES OUTPUT_NAME "${ARG_OUTPUT_NAME}" LINKER_LANGUAGE CXX WINDOWS_EXPORT_ALL_SYMBOLS ON
                          RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}" LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
    target_link_libraries(${name} PRIVATE ${others})
    foreach(target IN LISTS statics)
        target_include_directories(${name} INTERFACE "$<TARGET_PROPERTY:${target},INTERFACE_INCLUDE_DIRECTORIES>")
        target_compile_definitions(${name} INTERFACE "$<TARGET_PROPERTY:${target},INTERFACE_COMPILE_DEFINITIONS>")
    endforeach()
    target_compile_definitions(${name} INTERFACE HX_SHARED_IMPORT=1)
    helix_apply_options(${name})
endfunction()
