include_guard(GLOBAL)

# Library layout: Source/Helix/<Name>/<Topic>/..., platform code in .../Platform/<Win|Linux|Android|Web|Posix>/.
function(helix_collect_sources out_var root)
    file(GLOB_RECURSE all CONFIGURE_DEPENDS "${root}/*.cpp")
    set(result "")
    foreach(file IN LISTS all)
        set(keep ON)
        foreach(folder IN LISTS HELIX_PLATFORM_FOLDERS)
            if(file MATCHES "/Platform/${folder}/" AND NOT folder STREQUAL HELIX_PLATFORM_FOLDER)
                set(keep OFF)
            endif()
        endforeach()
        if(file MATCHES "/Platform/Posix/" AND NOT HELIX_PLATFORM_POSIX)
            set(keep OFF)
        endif()
        if(keep)
            list(APPEND result "${file}")
        endif()
    endforeach()
    set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

function(helix_add_library name)
    cmake_parse_arguments(ARG "TOOL" "ALIAS" "PUBLIC_DEPS;PRIVATE_DEPS" ${ARGN})
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Source/Helix")
    file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/Source/Helix/*.h")
    add_library(${name} STATIC ${sources} ${headers})
    add_library(Helix::${ARG_ALIAS} ALIAS ${name})
    target_include_directories(${name} PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Source>)
    target_link_libraries(${name} PUBLIC ${ARG_PUBLIC_DEPS} PRIVATE ${ARG_PRIVATE_DEPS})
    if(ARG_TOOL)
        helix_apply_options(${name} TOOL)
    else()
        helix_apply_options(${name})
    endif()
endfunction()

function(helix_add_executable name)
    cmake_parse_arguments(ARG "TOOL" "" "SOURCES;DEPS" ${ARGN})
    add_executable(${name} ${ARG_SOURCES})
    target_link_libraries(${name} PRIVATE ${ARG_DEPS})
    if(ARG_TOOL)
        helix_apply_options(${name} TOOL)
    else()
        helix_apply_options(${name})
    endif()
    if(HELIX_PLATFORM STREQUAL "web")
        target_link_options(${name} PRIVATE -sALLOW_MEMORY_GROWTH=1 -sEXIT_RUNTIME=1 -sENVIRONMENT=node)
    endif()
endfunction()

# Tests: every .cpp under Tests/ except files matching EXCLUDE; Tests/ is an include root for shared test helpers.
function(helix_add_test_suite name)
    if(NOT HELIX_BUILD_TESTS OR NOT PROJECT_IS_TOP_LEVEL)
        return()
    endif()
    cmake_parse_arguments(ARG "" "EXCLUDE" "DEPS;EXTRA_SOURCES" ${ARGN})
    helix_require(Testing)
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Tests")
    if(ARG_EXCLUDE)
        list(FILTER sources EXCLUDE REGEX "${ARG_EXCLUDE}")
    endif()
    helix_add_executable(${name} SOURCES ${sources} ${ARG_EXTRA_SOURCES} DEPS ${ARG_DEPS} Helix::TestMain)
    target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/Source ${CMAKE_CURRENT_SOURCE_DIR}/Tests)
    if(NOT HELIX_PLATFORM STREQUAL "android")
        add_test(NAME ${name} COMMAND ${name} --junit=${CMAKE_BINARY_DIR}/test-results/${name}.xml)
    endif()
endfunction()

function(helix_add_benchmark_suite name)
    if(NOT HELIX_BUILD_BENCHMARKS OR NOT PROJECT_IS_TOP_LEVEL)
        return()
    endif()
    cmake_parse_arguments(ARG "" "" "DEPS" ${ARGN})
    helix_require(Testing)
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Benchmarks")
    helix_add_executable(${name} SOURCES ${sources} DEPS ${ARG_DEPS} Helix::BenchMain)
    target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/Source)
endfunction()

# Fuzz targets: every .cpp under Fuzz/ on Helix::FuzzMain; ctest runs a short, fixed set of rounds (ROUNDS, 40).
function(helix_add_fuzz_suite name)
    if(NOT HELIX_BUILD_TESTS OR NOT PROJECT_IS_TOP_LEVEL)
        return()
    endif()
    cmake_parse_arguments(ARG "" "ROUNDS" "DEPS;EXTRA_SOURCES" ${ARGN})
    if(NOT ARG_ROUNDS)
        set(ARG_ROUNDS 40)
    endif()
    helix_require(Testing)
    helix_collect_sources(sources "${CMAKE_CURRENT_SOURCE_DIR}/Fuzz")
    helix_add_executable(${name} SOURCES ${sources} ${ARG_EXTRA_SOURCES} DEPS ${ARG_DEPS} Helix::FuzzMain)
    target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/Source ${CMAKE_CURRENT_SOURCE_DIR}/Tests)
    if(HELIX_PLATFORM STREQUAL "linux")
        # Names in the call stack of a crash.
        target_link_options(${name} PRIVATE -rdynamic)
    endif()
    if(NOT HELIX_PLATFORM STREQUAL "android")
        add_test(NAME ${name} COMMAND ${name} --rounds=${ARG_ROUNDS})
    endif()
endfunction()
