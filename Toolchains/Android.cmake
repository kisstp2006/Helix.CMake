set(HELIX_ANDROID_ABI "arm64-v8a" CACHE STRING "Android ABI")
set(HELIX_ANDROID_API "24" CACHE STRING "Android minimum API level")

if(NOT DEFINED HELIX_ANDROID_NDK)
    if(DEFINED ENV{ANDROID_NDK_HOME})
        set(HELIX_ANDROID_NDK "$ENV{ANDROID_NDK_HOME}")
    elseif(DEFINED ENV{ANDROID_NDK_ROOT})
        set(HELIX_ANDROID_NDK "$ENV{ANDROID_NDK_ROOT}")
    elseif(DEFINED ENV{ANDROID_HOME})
        file(GLOB ndks "$ENV{ANDROID_HOME}/ndk/*")
        list(SORT ndks COMPARE NATURAL ORDER DESCENDING)
        list(GET ndks 0 HELIX_ANDROID_NDK)
    endif()
endif()

if(NOT EXISTS "${HELIX_ANDROID_NDK}/build/cmake/android.toolchain.cmake")
    message(FATAL_ERROR "Helix: Android NDK not found. Set ANDROID_NDK_HOME or ANDROID_HOME.")
endif()

set(HELIX_ANDROID_NDK "${HELIX_ANDROID_NDK}" CACHE PATH "Android NDK root")
set(ANDROID_ABI "${HELIX_ANDROID_ABI}")
set(ANDROID_PLATFORM "android-${HELIX_ANDROID_API}")
set(ANDROID_STL c++_static)
include("${HELIX_ANDROID_NDK}/build/cmake/android.toolchain.cmake")
